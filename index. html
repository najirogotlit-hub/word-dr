<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,interactive-widget=resizes-content">
<title>Word Drop</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap">
<style>
:root{--night:#24145c;--grape:#4a2fbd;--lilac:#c9bcff;--paper:#fffdf6;--ink:#241a4d;--coral:#ff4f7b;--sun:#ffc83d;--mint:#27d3a2;
--disp:Prompt,"Noto Sans Thai",sans-serif;--cw:62px}
*{box-sizing:border-box;margin:0;padding:0}
[hidden]{display:none!important}
html{background:var(--night)}
body{min-height:100vh;min-height:100dvh;background:radial-gradient(120% 80% at 50% 35%,#5c3fd6 0,#35208a 45%,var(--night) 100%) fixed;color:#fff;font-family:var(--disp);line-height:1.5;-webkit-tap-highlight-color:transparent;overflow-x:hidden}
button,input{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none;touch-action:manipulation;user-select:none}
button:focus-visible,input:focus-visible{outline:3px solid var(--sun);outline-offset:3px}
.btn{background:#fff;color:var(--ink);border-radius:99px;padding:9px 20px;font-weight:500;box-shadow:0 4px 0 #00000040;transition:transform .12s,box-shadow .12s,filter .12s}
.btn:hover{filter:brightness(1.05);transform:translateY(-1px)}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 #00000040}
.btn.hot{background:var(--coral);color:#fff}
.btn.big{font-size:21px;padding:13px 44px}
.btn.ghost{background:#ffffff1f;color:#fff;box-shadow:none}
.icon{width:42px;height:42px;border-radius:50%;background:#ffffff1f;font-size:18px;flex:none;transition:background .15s,transform .12s}
.icon:hover{background:#ffffff38}.icon:active{transform:scale(.9)}

.card{--c:#3d6bf0;width:var(--cw);aspect-ratio:5/7;border-radius:calc(var(--cw)*.18);background:var(--c);border:3px solid var(--paper);color:#fff;font-family:var(--disp);font-weight:700;font-size:calc(var(--cw)*.56);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;flex:none;box-shadow:0 6px 14px #0b043055,inset 0 0 0 2px #ffffff30;line-height:1;text-shadow:0 3px 0 #0003}
.card small{font-size:calc(var(--cw)*.17);margin-top:4px}
.card em{position:absolute;top:-8px;right:-8px;min-width:28px;height:28px;border-radius:99px;background:var(--sun);color:var(--ink);border:2px solid var(--paper);font-style:normal;font-size:15px;display:grid;place-items:center;text-shadow:none}
.card.STOP{--c:#ee3e55}.card.REVERSE{--c:#12a574}.card.SWAP{--c:#8b46d9}.card.LIST{--c:#f4801f}
.card.JOKER{background:conic-gradient(from 210deg,#ff4f7b,#f4801f,#12a574,#3d6bf0,#8b46d9,#ff4f7b)}
.card.back{background:repeating-linear-gradient(45deg,#1c0f4d 0 7px,#2d1b75 7px 14px);font-size:calc(var(--cw)*.34)}
.card.empty{background:none;border:2px dashed #ffffff55;box-shadow:none;font-size:13px;font-family:inherit;text-shadow:none}

#home{max-width:520px;margin:0 auto;padding:26px 16px 40px;text-align:center}
h1{font-size:42px;font-weight:600;line-height:1.35;text-shadow:0 4px 0 #0004}
.tag{color:var(--lilac);margin-bottom:20px}
.sheet{background:var(--paper);color:var(--ink);border-radius:26px;padding:18px;text-align:left;margin-bottom:18px;box-shadow:0 16px 40px #0b043066}
.line{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.line>b{font-weight:500}
.seg{display:flex;background:#ece7ff;border-radius:99px;padding:3px}
.seg button{border-radius:99px;padding:5px 12px;font-size:14px;transition:background .18s,color .18s}
.seg button[aria-pressed="true"]{background:var(--grape);color:#fff}
.stepper{display:flex;align-items:center;gap:12px}
.stepper button{width:36px;height:36px;border-radius:50%;background:#ece7ff;font-size:20px}
.stepper output{font-family:var(--disp);font-size:24px;min-width:20px;text-align:center;font-weight:700}
.seat{display:flex;gap:8px;margin-bottom:8px}
.seat input{flex:1;min-width:0;border:2px solid #e4ddff;border-radius:14px;padding:7px 12px;background:#fff}
.seat button{width:104px;border-radius:14px;background:#ece7ff;font-size:14px}
.stack{display:flex;flex-direction:column;gap:10px;align-items:center}

#game{max-width:760px;margin:0 auto;height:100vh;height:100dvh;min-height:560px;display:flex;flex-direction:column;padding:10px 10px 0}
.bar{display:flex;align-items:center;gap:8px}
.bar .dir{flex:1;text-align:center;font-size:14px;color:var(--lilac)}
#opps{display:flex;gap:8px;overflow-x:auto;padding:12px 4px 6px;flex:none;scrollbar-width:none}
#opps>:first-child{margin-left:auto}#opps>:last-child{margin-right:auto}
.opp{flex:none;min-width:86px;max-width:130px;text-align:center;border-radius:18px;padding:6px 10px;background:#ffffff17;transition:background .25s,transform .25s,box-shadow .25s;font-size:13px}
.opp span{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.opp b{font-family:var(--disp);font-size:22px;font-weight:700}
.opp.on{background:#fff;color:var(--ink);transform:translateY(-4px);box-shadow:0 0 0 3px var(--sun),0 8px 22px #0005}
.opp.low b{color:var(--coral)}
#table{flex:1 0 auto;padding-bottom:8px;min-height:210px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}
.piles{display:flex;align-items:center;gap:clamp(10px,4vw,34px)}
#cat{width:158px;height:176px;border-radius:26px;background:#ee3e55;border:5px solid var(--paper);box-shadow:0 16px 34px #0b043077;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:6px}
#cat i{font-style:normal;font-size:50px;line-height:1.2}
#cat strong{font-family:var(--disp);font-weight:700;font-size:22px;line-height:1.1;text-shadow:0 3px 0 #0003}
#cat span{font-size:14px;margin-top:3px}
.pile{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:12px;color:var(--lilac)}
#say{min-height:56px;max-width:94%;text-align:center;background:#fff;color:var(--ink);border-radius:20px;padding:6px 20px;display:flex;flex-direction:column;justify-content:center}
#say b{font-family:var(--disp);font-weight:700;font-size:26px;color:var(--grape);line-height:1.15;overflow-wrap:anywhere}
#say small{font-size:13px}

#dock{flex:none;background:#150a3dcc;border-radius:28px 28px 0 0;padding:10px 10px max(12px,env(safe-area-inset-bottom));margin:0 -4px;border-top:2px solid #ffffff26}
.status{display:flex;align-items:center;gap:10px;margin:0 6px}
.status b{font-weight:500;flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
#secs{font-family:var(--disp);font-size:22px;min-width:34px;text-align:right;font-weight:700}
.track{height:8px;background:#ffffff22;border-radius:9px;margin:5px 6px 0;overflow:hidden}
#fill{height:100%;background:var(--mint);transform-origin:left;transition:transform .12s linear,background .3s}
.low #fill{background:var(--coral)}.low #secs{color:var(--coral)}
#hand{display:flex;flex-wrap:wrap;justify-content:center;align-content:flex-start;gap:7px;padding:16px 4px 8px;min-height:calc(var(--cw)*1.4 + 24px);max-height:34dvh;overflow-y:auto}
#hand.many{--cw:44px;max-height:30dvh}
#hand .card{transition:transform .18s cubic-bezier(.2,1.5,.4,1),box-shadow .18s,filter .2s}
#hand button.card:hover{transform:translateY(-5px)}
#hand button.card.sel{transform:translateY(-11px);box-shadow:0 0 0 3px var(--sun),0 14px 20px #0007}
#hand .card:disabled{cursor:default}
#hand.wait .card{filter:saturate(.6) brightness(.8)}
.hidden-hand{align-self:center;color:var(--lilac)}
#controls{max-width:480px;margin:0 auto}
#form{display:flex;gap:8px}
#word{flex:1;min-width:0;border:0;border-radius:99px;background:#fff;color:var(--ink);padding:10px 18px;font-size:18px}
#word:disabled{background:#ffffff80}
#form .btn{flex:none}
#err{min-height:24px;text-align:center;font-size:14px;color:#ffd3dd;padding:2px}
.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-8px)}50%{transform:translateX(7px)}75%{transform:translateX(-4px)}}
.under{text-align:center}

#over{position:fixed;inset:0;z-index:20;display:flex;padding:18px;background:#160a42cc;overflow:auto;animation:fade .2s}
#over.solid{background:var(--night)}
@keyframes fade{from{opacity:0}}
.box{margin:auto;width:100%;max-width:440px;background:var(--paper);color:var(--ink);border-radius:28px;padding:22px;text-align:center;box-shadow:0 20px 60px #0008;animation:pop .35s cubic-bezier(.2,1.4,.4,1)}
@keyframes pop{from{transform:scale(.85) translateY(20px)}}
.box h2{font-weight:600;font-size:22px;margin-bottom:8px;overflow-wrap:anywhere}
.box .btn{border:2px solid #e4ddff}.box .btn.hot{border-color:var(--coral)}
.choices{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:14px}
.pickcat{width:116px;min-height:140px;border-radius:20px;background:#ee3e55;color:#fff;padding:8px;line-height:1.25;transition:transform .15s}
.pickcat:hover{transform:translateY(-6px) rotate(-2deg)}
.pickcat i{display:block;font-style:normal;font-size:38px}.pickcat b{font-family:var(--disp);font-weight:700;display:block}.pickcat small{font-size:12px}
.box ul{text-align:left;padding-left:20px;font-size:14px;margin-top:8px}
.box .log{list-style:none;padding:0;max-height:45vh;overflow:auto}
.box .log li{padding:5px 0;border-bottom:1px solid #eee8ff}
.rank{display:flex;justify-content:space-between;padding:6px 14px;border-radius:12px;background:#ece7ff;margin-top:6px}
.fly{position:fixed;z-index:15;pointer-events:none;margin:0}
.confetti{position:fixed;top:-20px;width:9px;height:16px;border-radius:3px;z-index:30;pointer-events:none}

.art{width:1em;height:1em;display:block;fill:none;stroke:#241a4d;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.card .art{font-size:calc(var(--cw)*.66);filter:drop-shadow(0 3px 0 #0003)}
.card{box-shadow:0 2px 0 #fff8 inset,0 4px 0 #160a4255,0 12px 22px #0b043066;overflow:visible}
.card::after{content:"";position:absolute;inset:3px 3px 52% 3px;border-radius:calc(var(--cw)*.12) calc(var(--cw)*.12) 50% 50%;background:linear-gradient(#ffffff38,#ffffff08);pointer-events:none}
.card.empty::after{display:none}
.card em{z-index:1;box-shadow:0 3px 8px #0006;animation:wobble 2.4s ease-in-out infinite}
@keyframes wobble{0%,70%,100%{transform:rotate(0)}76%{transform:rotate(-16deg) scale(1.12)}84%{transform:rotate(12deg) scale(1.12)}92%{transform:rotate(-5deg)}}
.icon{display:grid;place-items:center;box-shadow:0 4px 0 #0b043055,0 8px 16px #0b043044;background:#fff;font-size:26px}
.icon:hover{background:#fff4cf}.icon:active{transform:translateY(3px) scale(.95);box-shadow:0 1px 0 #0b043055}
.btn{box-shadow:0 4px 0 #0b043055,0 10px 20px #0b043040}
.btn.hot{position:relative;overflow:hidden}
.btn.hot:not(:disabled)::after{content:"";position:absolute;top:0;bottom:0;width:34%;left:-60%;background:linear-gradient(100deg,#fff0,#ffffff66,#fff0);animation:shine 3.2s ease-in-out infinite}
@keyframes shine{55%,100%{left:140%}}
.sheet{box-shadow:0 6px 0 #c9bcff,0 22px 44px #0b043088}
.opp{box-shadow:0 5px 14px #0b043055,inset 0 1px 0 #ffffff33}
.opp .art{font-size:38px;margin:0 auto -2px}
.opp.on{box-shadow:0 0 0 3px var(--sun),0 12px 26px #0008}
.opp.on .art{animation:bounce 1s ease-in-out infinite}
@keyframes bounce{50%{transform:translateY(-4px) rotate(5deg)}}
#cat{box-shadow:0 8px 0 #a91f38,0 24px 40px #0b0430aa;position:relative}
#cat::before{content:"";position:absolute;inset:-14px;border-radius:36px;border:3px dashed #ffc83d99;animation:breathe 2.6s ease-in-out infinite;pointer-events:none}
@keyframes breathe{50%{transform:scale(1.045);opacity:.45}}
#cat .art{font-size:68px;margin-bottom:4px}
.draw .art{animation:pop .5s cubic-bezier(.2,1.6,.4,1) both}

.pile .card{filter:drop-shadow(0 6px 4px #0b043066)}
#say{position:relative;z-index:1;box-shadow:0 5px 0 #c9bcff,0 14px 26px #0b043066}
#dock{box-shadow:0 -12px 34px #0b043088}
#word{box-shadow:inset 0 3px 6px #24145c33,0 4px 12px #0b043055}
.pickcat{box-shadow:0 6px 0 #a91f38,0 14px 24px #0b043055;animation:pop .45s cubic-bezier(.2,1.5,.4,1) both}
.pickcat:nth-child(2){animation-delay:.08s}.pickcat:nth-child(3){animation-delay:.16s}
.pickcat .art{font-size:56px;margin:0 auto 4px}
.rank{animation:pop .4s cubic-bezier(.2,1.4,.4,1) both;align-items:center;box-shadow:0 3px 0 #c9bcff}
.big-art .art{font-size:112px;margin:0 auto 6px;animation:bounce 1.6s ease-in-out infinite}
.box li .art{display:inline-block;font-size:26px;vertical-align:middle;margin-right:4px}
.seat button{display:flex;align-items:center;justify-content:center;gap:4px}.seat .art{font-size:30px}
.seat input{box-shadow:inset 0 2px 5px #24145c14}
.hero{display:flex;justify-content:center;align-items:flex-end;gap:2px;height:150px;margin-bottom:6px}
.hero .art{font-size:96px;filter:drop-shadow(0 12px 8px #0b043077);animation:float 3.4s ease-in-out infinite}
.hero .art:nth-child(2){font-size:140px;animation-delay:-1.2s;z-index:1}.hero .art:nth-child(3){animation-delay:-2.3s}
@keyframes float{50%{transform:translateY(-10px) rotate(3deg)}}
#doodles{position:fixed;inset:0;pointer-events:none;z-index:-1;overflow:hidden}
#doodles .art{position:absolute;stroke:#c9bcff;opacity:.28;animation:drift 9s ease-in-out infinite}
@keyframes drift{50%{transform:translate(8px,-18px) rotate(18deg)}}
body{isolation:isolate}

body:has(#game:not([hidden])) #doodles{display:none}
#game{max-width:680px;gap:6px}
.icon{width:40px;height:40px;font-size:24px}
.dir{opacity:.9}
#opps{padding:8px 4px}
.opp{display:grid;grid-template-columns:auto auto;grid-template-rows:auto auto;column-gap:8px;align-items:center;text-align:left;min-width:0;padding:6px 14px 6px 8px;line-height:1.25}
.opp .art{grid-row:span 2;font-size:36px;margin:0}
.opp span{max-width:84px}
.opp b{font-size:17px}.opp b+i{display:none}
.opp.on{transform:none}.opp.on .art{animation:bounce .5s ease 2}
#cat::before,.card em,.btn.hot:not(:disabled)::after{animation:none}
#cat::before,.btn.hot::after{display:none}
#say{border:0;cursor:pointer;min-width:180px;font:inherit}
#dock{padding-top:12px}
.status{gap:12px;min-height:38px}
#draw{font-size:14px;padding:6px 16px;box-shadow:none}
#hand{flex-wrap:nowrap;justify-content:safe center;overflow-x:auto;overflow-y:hidden;gap:0;padding:20px 8px 12px;max-height:none;scrollbar-width:none;scroll-behavior:smooth}
#hand.many{--cw:56px;max-height:none}
#hand .card em{right:auto;left:-5px;top:-10px}
#hand{margin:0 auto;column-gap:4px;row-gap:12px;align-items:flex-end;min-height:0}
#hand.two{flex-wrap:wrap;align-content:flex-start;max-height:calc(var(--cw)*2.8 + 46px);overflow-y:auto}
#hand.tiny .card small{display:none}#hand.tiny .card .art{font-size:calc(var(--cw)*.76)}
#err{margin-top:8px;min-height:24px;color:var(--lilac)}
#err.bad{color:#ffd3dd;font-weight:500}
@media(max-height:700px){#cat{width:136px;height:142px}#cat strong{font-size:19px}:root{--cw:54px}#hand.many{--cw:46px}#say{min-height:48px}#table{min-height:196px;gap:8px}}
@media(max-height:700px){#game{min-height:540px;padding-top:6px}.icon{width:36px;height:36px;font-size:16px}#opps{padding:8px 4px 2px}.opp{padding:2px 10px;line-height:1.35}.opp b{font-size:18px}.pile{font-size:0;gap:0}#table{min-height:178px;gap:6px;padding-bottom:6px}#cat{height:124px}#say{min-height:42px;padding:2px 16px}#say b{font-size:20px}#say small{font-size:11px;line-height:1.2}#dock{padding-top:6px}#hand{padding:12px 4px 6px;min-height:calc(var(--cw)*1.4 + 18px)}:root{--cw:48px}#hand.many{--cw:42px}#word{padding:6px 16px;font-size:16px}#form .btn{padding:6px 18px}#err{min-height:20px;font-size:12px;padding:0}#draw{padding:5px 18px;font-size:14px}}
.btn:disabled{opacity:.45;cursor:default}
@media(max-width:360px){:root{--cw:52px}#cat{width:134px}}
@media(max-height:700px){.opp .art{display:none}#cat .art{font-size:40px;margin:0}.hero{height:110px}}
@media(max-height:700px){#game{gap:0}#opps{padding:5px 4px}.opp{padding:3px 10px}.opp .art{display:block;font-size:28px}#hand{padding:14px 8px 6px}#err{margin-top:5px;min-height:20px}.status{min-height:32px}#cat .art{font-size:36px}}

.box h3{font-size:16px;font-weight:600;text-align:left;margin-top:14px;color:#6420c4}
.goal{background:#fff0c2;border-radius:14px;padding:8px;font-weight:500}
.box ol.steps{list-style:none;padding:0;counter-reset:n;text-align:left;margin-top:12px}
.steps li{counter-increment:n;display:grid;grid-template-columns:32px 1fr;column-gap:10px;margin-bottom:8px;line-height:1.35}
.steps li::before{content:counter(n);grid-row:span 2;width:32px;height:32px;border-radius:50%;background:#ff4f7b;color:#fff;display:grid;place-items:center;font-weight:700}
.steps b{font-weight:600}.steps span{font-size:13px}
.box ul.specials{list-style:none;padding:0}
.specials li{display:flex;gap:12px;align-items:center;margin-top:8px;font-size:13px;line-height:1.4}.specials b{display:block;font-size:15px}
.box .specials .card{--cw:38px;box-shadow:0 3px 8px #0b043033}.box .specials .art{display:block;margin:0;font-size:28px}
.card.PLUS{--c:#e83e8c}
.box.wide{max-width:560px;height:calc(100dvh - 36px);display:flex;flex-direction:column;padding:16px}
.wide .bookbox{flex:1;min-height:0;display:flex;flex-direction:column;gap:8px}
.wide .choices{margin-top:10px}
.tabs{align-self:center}.tabs button{padding:5px 20px}
.cats{display:flex;gap:8px;overflow-x:auto;flex:none;padding:4px 2px 8px}
.cats button{flex:none;width:76px;border-radius:16px;background:#ece7ff;padding:6px 2px;font-size:11px;line-height:1.3;transition:background .15s,transform .12s}
.cats button:active{transform:scale(.94)}
.cats button[aria-pressed="true"]{background:#ee3e55;color:#fff;box-shadow:0 4px 0 #a91f38}
.cats .art{font-size:34px;margin:0 auto 2px}
#q,#jotword{width:100%;min-width:0;border:2px solid #e4ddff;border-radius:99px;padding:8px 16px;background:#fff;flex:none}
#jot{display:flex;gap:8px}#jot #jotword{flex:1;width:auto}#jot .btn{flex:none}
.only{font-size:14px;display:flex;gap:8px;justify-content:center;align-items:center}
#list{flex:1;min-height:0;overflow-y:auto;text-align:left;overscroll-behavior:contain}
.note{font-size:13px;color:#6b5f8f;text-align:center}.note.bad{color:#c4143c;min-height:0}.note.bad:empty{display:none}
.group{display:grid;grid-template-columns:32px 1fr;gap:8px;margin-top:10px}
.group>b{width:32px;height:32px;border-radius:10px;background:#ece7ff;display:grid;place-items:center}
.group>b.have{background:#3d6bf0;color:#fff}
.group>div{display:flex;flex-wrap:wrap;gap:6px}
.group button{border-radius:99px;background:#fff;border:2px solid #e4ddff;padding:2px 12px;font-size:14px}
.group button:not(:disabled):hover{border-color:#6420c4;background:#f3efff}
.group button:disabled{cursor:default}.group button.used{text-decoration:line-through;opacity:.5;background:#eee}
.box ol.jotted{list-style:none;padding:0}
.jotted li{display:flex;gap:10px;align-items:center;padding:6px 12px;border-radius:12px;background:#f3efff;margin-top:5px}
.jotted b{flex:1;font-weight:500;overflow-wrap:anywhere}.jotted span{font-size:12px;color:#6b5f8f}.jotted button{color:#c4143c;font-size:13px}
@media(max-height:700px){.cats .art{display:none}.cats button{width:auto;padding:5px 12px}.wide h2{display:none}}
.langs{align-self:center;display:inline-flex;margin-bottom:10px}.langs button{padding:5px 22px}
.cats span{display:block;line-height:1.2}
.chara{width:100%;height:100%;display:block;overflow:hidden}
.chara .eye{transform-box:fill-box;transform-origin:center;animation:blink 4.2s infinite}
@keyframes blink{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.08)}}
.ava{display:block;width:44px;height:44px;border-radius:50%;background:var(--b);overflow:hidden;border:2.5px solid #fff;box-shadow:0 3px 8px #0b043055;flex:none}
.ava .chara{width:108%;height:108%;margin:2px -4% 0}
